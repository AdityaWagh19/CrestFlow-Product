%% CrestFlow - System Architecture Overview (report level)
%% Type: layered architecture view
%% Rule: topology only. Policy semantics live in policy_engine.md.
flowchart TB
  subgraph L1["1 Interface"]
    API["REST<br/>API"]
    COP["Copilot and x402"]
  end

  subgraph L2["2 Intelligence"]
    INTEL["E1 to E6<br/>portfolio, risk, yield,<br/>strategy, user, execution"]
  end

  subgraph L3["3 Execution"]
    EXEC["Execution pipeline<br/>E6, Router, Planner,<br/>Simulation, Policy, CCE, PSM"]
  end

  subgraph L4["4 Protocol"]
    PROTO["EVM, Solana, CCTP adapters"]
  end

  subgraph L5["5 Data"]
    FKL["Financial Knowledge"]
    PSM["Portfolio State"]
    AUD["Audit"]
  end

  USER["Users and Admin"]
  PROV["Identity and data providers"]
  CHAIN["Chains and RPC"]

  USER --> API
  USER --> COP
  API --> INTEL
  COP --> INTEL
  INTEL --> EXEC
  EXEC --> PROTO
  PROTO --> CHAIN
  PROTO ~~~ FKL
  EXEC --> PSM
  PSM --> INTEL
  PROV --> FKL
  FKL --> INTEL
  INTEL -.-> AUD
  EXEC -.-> AUD

  classDef external fill:#ffffff,stroke:#000000,stroke-width:1px,stroke-dasharray:5 3,color:#000000
  class USER,PROV,CHAIN external