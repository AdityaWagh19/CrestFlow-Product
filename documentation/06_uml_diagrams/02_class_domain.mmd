%% CrestFlow - Domain Class Diagram (report level)
%% Type: UML class diagram
%% Rule: business records and the decision chain only. Enums and table detail live in canonical_schemas.md.
classDiagram
  direction LR

  class User {
    +string googleSub
    +KycStatus kycStatus
    +KycTier kycTier
  }

  class AddressScope {
    +string address
    +Chain chain
    +ExecutionMode executionMode
  }

  class GoalProfile {
    +Persona persona
    +Usd maxUsdPerTransaction
  }

  class PortfolioSnapshot {
    +Usd totalValueUsd
    +DataQuality dataQuality
  }

  class Position {
    +Chain chain
    +ProtocolId protocol
    +Usd valueUsd
  }

  class RiskSnapshot {
    +number riskScore
    +number adjustedThreshold
  }

  class YieldOpportunity {
    +ProtocolId protocol
    +Percent twapApy7dPercent
  }

  class StrategyPlan {
    +DriftUrgency urgency
    +Usd totalValueUsd
  }

  class ExecutionIntent {
    +ExecutionMode executionMode
    +DriftUrgency urgency
  }

  class PolicyDecision {
    +PolicyDecisionStatus decision
    +string policyVersion
  }

  class CctpTransfer {
    +Chain sourceChain
    +CctpTransferStatus status
  }

  class AuditEntry {
    +UUID eventId
    +AuditCategory category
    +AuditAction action
  }

  class PaymentRecord {
    +PaymentNetwork network
    +BaseUnits amount
    +PaymentStatus status
  }

  User "1" --> "0..*" AddressScope : owns
  User "1" --> "0..1" GoalProfile : sets
  User "1" --> "0..*" PortfolioSnapshot : has
  User "1" --> "0..*" StrategyPlan : receives
  User "0..1" --> "0..*" AuditEntry : generates
  User "0..1" --> "0..*" PaymentRecord : pays

  PortfolioSnapshot "1" *-- "0..*" Position : contains
  PortfolioSnapshot "1" --> "0..*" RiskSnapshot : analyzed by
  RiskSnapshot "1" --> "0..*" StrategyPlan : informs
  YieldOpportunity "1" --> "0..*" StrategyPlan : informs

  StrategyPlan "1" --> "0..*" ExecutionIntent : produces
  ExecutionIntent "1" --> "1" PolicyDecision : evaluated by
  ExecutionIntent "1" --> "0..1" CctpTransfer : may bridge

  note for User "googleSub is the identity anchor, email is mutable"
  note for PolicyDecision "Exactly nine check results, no short-circuit"
  note for CctpTransfer "USDC only, CCTP V2, fail closed otherwise"
