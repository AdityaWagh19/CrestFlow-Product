%% CrestFlow - Sequence Diagram: CCTP V2 Bridge (report level)
%% Type: UML sequence diagram
%% Rule: burn, attest, mint for USDC only.
sequenceDiagram
  participant ROUTER as Router and Planner
  participant PE as Policy Engine
  participant CCE as CCE
  participant CIRCLE as Circle Iris
  participant CHAIN as Source and destination chains

  ROUTER->>PE: bridge intent
  PE-->>ROUTER: APPROVED or BLOCKED

  alt APPROVED
    ROUTER->>CCE: burn USDC on source
    CCE->>CHAIN: depositForBurn
    CHAIN-->>CCE: burn receipt
    CCE->>CIRCLE: request attestation
    CIRCLE-->>CCE: attestation
    CCE->>CHAIN: mint on destination
    CHAIN-->>CCE: mint receipt
    CCE-->>ROUTER: reconciled
  else BLOCKED
    PE-->>ROUTER: fail closed
  end

  note over ROUTER: USDC only, unsupported routes fail closed
  note over CCE: Standard is default, Fast is opt-in<br/>for HIGH urgency
  note over CCE: AUTOPILOT signs in the TEE,<br/>MANUAL uses the user wallet
