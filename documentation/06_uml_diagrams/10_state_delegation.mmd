%% CrestFlow - State Machine: Autopilot Delegation (report level)
%% Type: UML state machine
stateDiagram-v2
  state "NOT_<br/>PROVISIONED" as NOT_PROVISIONED
  [*] --> NOT_PROVISIONED
  NOT_PROVISIONED --> PROVISIONING : provision wallet
  PROVISIONING --> ACTIVE : keys and scope ready
  PROVISIONING --> NOT_PROVISIONED : failed

  ACTIVE --> PAUSED : user, admin, or critical alert
  PAUSED --> ACTIVE : resume with KYC approved
  ACTIVE --> REVOKED : wallet removed
  PAUSED --> REVOKED : account suspended
  REVOKED --> [*]

  note right of ACTIVE : Policy check 3 requires active delegation no older than 4 hours
  note left of NOT_PROVISIONED : Path B has no delegation lifecycle
