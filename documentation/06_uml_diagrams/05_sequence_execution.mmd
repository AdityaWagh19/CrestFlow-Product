%% CrestFlow - Sequence Diagram: Execution Pipeline (report level)
%% Type: UML sequence diagram
%% Rule: approval gate and signing path only. The canonical D7 order is stated in a note.
sequenceDiagram
  actor Trigger as User or Scheduler
  participant FLOW as Planning and Build
  participant PE as Policy Engine
  participant CCE as CCE
  participant PSM as Portfolio State
  participant CHAIN as Chain

  Trigger->>FLOW: trigger
  FLOW->>PE: SimulationPassedPackage
  PE-->>FLOW: PolicyDecision

  alt APPROVED
    FLOW->>CCE: authorized package
    CCE->>CHAIN: broadcast
    CHAIN-->>CCE: receipt
    CCE->>PSM: reconcile
    PSM-->>Trigger: complete
  else BLOCKED
    PE-->>Trigger: failure summary
  end

  note over FLOW: D7 order is E6, Router, Planner, Simulation
  note over CCE: AUTOPILOT signs in the TEE, MANUAL returns an unsigned transaction
