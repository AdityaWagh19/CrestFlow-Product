%% CrestFlow - Activity Diagram: Transaction Execution (report level)
%% Type: UML activity diagram
flowchart TD
  subgraph USER["User"]
    START([Start])
    APPROVE["Trigger or approve plan"]
    DONE(((End)))
  end

  subgraph SYSTEM["CrestFlow"]
    INTENT["Create execution intent"]
    BUILD["Build and simulate"]
    SIMOK{"Simulation passed?"}
    POLICY["Policy, nine checks"]
    PEOK{"Policy approved?"}
    SIGN["Sign in TEE or user wallet"]
    BROADCAST["Broadcast"]
    RECON["Reconcile portfolio"]
    COMP["Compensate"]
    BLOCKED(((Blocked)))
    FAILED(((Failed)))
  end

  subgraph CHAIN["Chain"]
    CONFIRM["Confirm receipt<br/>CCTP is burn, attest, mint"]
    CHAINOK{"Confirmed?"}
  end

  START --> APPROVE --> INTENT --> BUILD --> SIMOK
  SIMOK -- no --> FAILED
  SIMOK -- yes --> POLICY --> PEOK
  PEOK -- no --> BLOCKED
  PEOK -- yes --> SIGN --> BROADCAST --> CONFIRM --> CHAINOK
  CHAINOK -- no --> COMP --> FAILED
  CHAINOK -- yes --> RECON --> DONE
