%% CrestFlow - Deployment Diagram (report level)
%% Type: UML deployment view expressed as a Mermaid flowchart
%% Rule: trust zones and the key boundary only.
flowchart LR
  subgraph CLIENT["Client - untrusted"]
    BROWSER["Browser and dApp"]
  end

  subgraph EDGE["Edge"]
    GW["API gateway<br/>TLS"]
  end

  subgraph VPC["Private VPC - trusted"]
    API["NestJS API"]
    WORKER["BullMQ workers"]
    PG[("PostgreSQL")]
    REDIS[("Redis")]
    KMS["KMS and secrets"]
  end

  subgraph PROVIDERS["External providers - contractual trust"]
    TURNKEY["Turnkey TEE<br/>holds keys"]
    OTHER["Data, identity,<br/>RPC and payments"]
  end

  subgraph CHAINS["Public chains - trustless"]
    CHAIN["EVM chains and Solana"]
  end

  BROWSER -->|HTTPS| GW
  GW --> API
  API --> PG
  API <--> REDIS
  WORKER <--> REDIS
  WORKER --> PG
  API --> KMS
  WORKER --> KMS
  API -->|sign request| TURNKEY
  API --> OTHER
  OTHER -->|RPC| CHAIN

  classDef external fill:#ffffff,stroke:#000000,stroke-width:1px,stroke-dasharray:5 3,color:#000000
  class TURNKEY,OTHER,CHAIN external
