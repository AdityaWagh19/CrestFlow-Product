%% CrestFlow - State Machine: KYC Lifecycle (report level)
%% Type: UML state machine
stateDiagram-v2
  state "PENDING" as PENDING
  state "APPROVED" as APPROVED
  state "REJECTED" as REJECTED
  state "RESUBMISSION<br/>REQUESTED" as RESUBMISSION_REQUESTED
  state "SUSPENDED" as SUSPENDED
  state "EXPIRED" as EXPIRED
  [*] --> PENDING
  PENDING --> APPROVED : approved
  PENDING --> REJECTED : rejected
  PENDING --> RESUBMISSION_REQUESTED : more documents

  REJECTED --> PENDING : resubmit
  RESUBMISSION_REQUESTED --> PENDING : resubmit
  APPROVED --> SUSPENDED : sanctions or admin action
  APPROVED --> EXPIRED : manual expiry
  SUSPENDED --> PENDING : lifted and reapply
  EXPIRED --> PENDING : re-verify

  note right of APPROVED : Tier 1k, 10k, or unlimited
  note left of PENDING : Only APPROVED passes policy check 1
