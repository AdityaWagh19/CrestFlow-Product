%% CrestFlow - Use Case Diagram (report level)
%% Type: UML use case view expressed as a Mermaid flowchart
%% Actors use the UML stereotype because Mermaid has no native actor shape.
flowchart LR
  U["«actor»<br/>User<br/>Path A or Path B"]
  ADM["«actor»<br/>Admin"]
  SYS["«actor»<br/>System"]
  EXT["«actor»<br/>External providers"]

  subgraph BOUNDARY["CrestFlow System Boundary"]
    UC1(["Sign in"])
    UC2(["Link wallet"])
    UC3(["Complete KYC"])
    UC4(["View portfolio and risk"])
    UC5(["Find yield opportunities"])
    UC6(["Manage goals and autopilot<br/>(Path A only)"])
    UC7(["Review and approve plan<br/>(Path B manual)"])
    UC8(["Query Copilot"])
    UC9(["Administer users and policy"])
    UC10(["Run scans and webhooks"])
  end

  U --> UC1
  U --> UC2
  U --> UC3
  U --> UC4
  U --> UC5
  U --> UC6
  U --> UC7
  U --> UC8
  ADM --> UC9
  SYS --> UC10
  EXT --> UC3

  style BOUNDARY fill:#ffffff,stroke:#000000,stroke-dasharray:6 4