%% CrestFlow - Core Entity-Relationship Diagram (report level)
%% Type: ER diagram; logical entities, not the full physical schema.
erDiagram
  USERS {
    uuid id PK
    string google_sub UK
    string kyc_status
  }

  ADDRESS_SCOPES {
    uuid id PK
    uuid user_id FK
    string execution_mode
  }

  KYC_RECORDS {
    uuid id PK
    uuid user_id FK
    string status
  }

  GOAL_PROFILES {
    uuid id PK
    uuid user_id FK
    string persona
  }

  PORTFOLIO_SNAPSHOTS {
    uuid id PK
    uuid user_id FK
    numeric total_value_usd
  }

  POSITIONS {
    uuid id PK
    uuid snapshot_id FK
    numeric value_usd
  }

  RISK_SNAPSHOTS {
    uuid id PK
    uuid snapshot_id FK
    numeric risk_score
  }

  YIELD_OPPORTUNITIES {
    uuid id PK
    string protocol
    numeric twap_apy_7d
  }

  STRATEGY_PLANS {
    uuid id PK
    uuid user_id FK
    string urgency
  }

  EXECUTION_INTENTS {
    uuid id PK
    uuid plan_id FK
    string execution_mode
  }

  POLICY_DECISIONS {
    uuid id PK
    uuid plan_id FK
    string decision
  }

  AUDIT_ENTRIES {
    uuid event_id PK
    timestamptz created_at PK
    string action
  }

  PAYMENTS {
    uuid id PK
    uuid user_id FK
    string status
  }

  USERS ||--o{ ADDRESS_SCOPES : owns
  USERS ||--o{ KYC_RECORDS : submits
  USERS ||--o{ GOAL_PROFILES : sets
  USERS ||--o{ PORTFOLIO_SNAPSHOTS : has
  USERS ||--o{ STRATEGY_PLANS : receives
  USERS o|--o{ AUDIT_ENTRIES : generates
  USERS o|--o{ PAYMENTS : pays

  PORTFOLIO_SNAPSHOTS ||--o{ POSITIONS : contains
  PORTFOLIO_SNAPSHOTS ||--o{ RISK_SNAPSHOTS : analyzed_by
  RISK_SNAPSHOTS ||--o{ STRATEGY_PLANS : informs
  YIELD_OPPORTUNITIES ||--o{ STRATEGY_PLANS : informs

  STRATEGY_PLANS ||--o{ EXECUTION_INTENTS : produces
  STRATEGY_PLANS ||--o{ POLICY_DECISIONS : evaluated_for
  EXECUTION_INTENTS ||--o| POLICY_DECISIONS : gated_by
