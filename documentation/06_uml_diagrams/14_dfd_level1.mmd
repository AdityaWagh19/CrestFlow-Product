%% CrestFlow - DFD Level 1: Subsystem Decomposition (report level)
%% Type: data flow diagram, not UML
flowchart LR
  U["User and Admin"]
  IDP["Identity providers"]
  MKT["Market data"]
  CHAIN["Chains and RPC"]
  PAYF["x402 Facilitator"]

  P1(("1.0<br/>Identity"))
  P2(("2.0<br/>Intelligence"))
  P3(("3.0<br/>Execution"))
  P4(("4.0<br/>Portfolio state"))
  P5(("5.0<br/>Audit"))
  P6(("6.0<br/>Payments"))

  DS1[("DS1<br/>PostgreSQL")]
  DS2[("DS2<br/>Redis and BullMQ")]

  U <--> P1
  IDP <--> P1
  P1 -->|user, KYC, goals| P2

  MKT -->|market data| P2
  DS2 -->|cache| P2
  P2 -->|strategy plan| P3

  P3 <--> CHAIN
  P3 -->|executed<br/>actions| P4
  P4 -->|snapshot| P2
  P4 -->|portfolio view| U
  P4 --> DS1

  P1 -->|audit events| P5
  P3 -->|audit events| P5
  P6 -->|audit events| P5
  P5 --> DS1

  P6 <--> PAYF
  P6 -->|authorized query| P2
  P2 --> DS2
